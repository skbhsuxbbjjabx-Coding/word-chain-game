{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "outputDirectory": ".",
  "rewrites": [
    {
      "source": "/api",
      "destination": "/api/index.js"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js?_route=$1"
    }
  ],
  "functions": {
    "api/index.js": {
      "includeFiles": "data/**",
      "memory": 1024,
      "maxDuration": 15
    }
  }
}
